{
  "name": "dexcom-vs-code-extension",
  "displayName": "Dexcom CGM Status Bar",
  "description": "Visual Studio Code extension that retrieves the most recent blood glucose reading from Dexcom web services and displays it in your Visual Studio Code status bar.",
  "icon": "images/dexcom-vs-code-logo.png",
  "version": "0.8.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/borkod/dexcom-vs-code-extension"
  },
  "homepage": "https://github.com/borkod/dexcom-vs-code-extension",
  "bugs": {
    "url": "https://github.com/borkod/dexcom-vs-code-extension/issues"
  },
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "pricing": "Free",
  "publisher": "borkod",
  "keywords": [
    "Dexcom",
    "blood glucose",
    "diabetes",
    "status bar"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "sponsor": {
    "url": "https://github.com/sponsors/borkod"
  },
  "contributes": {
    "commands": [
      {
        "command": "dexcom-vs-code-extension.update-and-show-date",
        "title": "Dexcom: Update and Show Last Entry Date"
      }
    ],
    "configuration": {
      "title": "Dexcom Status Bar",
      "properties": {
        "dexcom-vs-code-extension.dexcomUsername": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Dexcom Login Email (e.g. `mail@example.com`)"
        },
        "dexcom-vs-code-extension.dexcomPassword": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Dexcom Login Password"
        },
        "dexcom-vs-code-extension.dexcomRegion": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "eu",
            "us"
          ],
          "default": "us",
          "markdownDescription": "Your region. Used to determine the correct Dexcom service (Possible values: eu, us). If you are in the US, use 'us'. Any other country (e.g. Canada) should use 'eu'."
        },
        "dexcom-vs-code-extension.glucoseUnits": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "millimolar",
            "milligrams"
          ],
          "markdownEnumDescriptions": [
            "mmol/L (Millimoles Per Litre)",
            "mg/dL (Milligrams per 100 millilitres)"
          ],
          "enumItemLabels": [
            "mmol/L",
            "mg/dL"
          ],
          "default": "milligrams",
          "description": "Blood glucose units"
        },
        "dexcom-vs-code-extension.high-glucose-warning-message.enabled": {
          "type": "boolean",
          "scope": "machine",
          "default": true,
          "description": "Enable high glucose warning pop-up message"
        },
        "dexcom-vs-code-extension.high-glucose-warning.value": {
          "type": "number",
          "scope": "machine",
          "default": 180,
          "description": "High glucose warning value (in mg/dL)"
        },
        "dexcom-vs-code-extension.low-glucose-warning-message.enabled": {
          "type": "boolean",
          "scope": "machine",
          "default": true,
          "description": "Enable low glucose warning pop-up message"
        },
        "dexcom-vs-code-extension.glucose-warning-background-color.enabled": {
          "type": "boolean",
          "scope": "machine",
          "default": true,
          "description": "Enable high or low glucose warning background color"
        },
        "dexcom-vs-code-extension.low-glucose-warning.value": {
          "type": "number",
          "scope": "machine",
          "default": 70,
          "description": "Low glucose warning value (in mg/dL)"
        },
        "dexcom-vs-code-extension.updateInterval": {
          "type": "number",
          "scope": "machine",
          "default": 10,
          "markdownDescription": "Time interval (in minutes) between queries for updated data"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.10",
    "eslint": "^9.16.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "axios": "~1.12.2"
  }
}
